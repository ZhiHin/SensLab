# ---------------------------------------------------------------------------
# SensLab environment.
# Copy to `.env.local` for development. Every variable here is validated at
# startup by src/lib/env.ts — a missing or malformed value is a startup failure,
# never a runtime surprise (doc 18 §18.10).
# ---------------------------------------------------------------------------

# Runtime mode. One of: development | test | production
NODE_ENV=development

# Public origin of this deployment. Used for absolute links and for the
# Origin/Sec-Fetch-Site check on mutating requests (doc 23 §23.5).
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Runtime connection. MUST use the least-privilege application role
# (`senslab_app`), which has no DDL rights (SENS-SEC-015).
DATABASE_URL=postgres://senslab_app:senslab_app_password@localhost:5435/senslab

# Migration connection. Uses the owner/migrator role. Only the migration step
# ever reads this, and it is never present in the application runtime.
DATABASE_MIGRATION_URL=postgres://senslab_owner:senslab_dev_password@localhost:5435/senslab

# Maximum pooled connections for the runtime role.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# 32+ byte random string. Used to derive the pepper for hashed session and
# guest tokens. Rotate only with a documented migration.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-48-byte-random-value-at-least-32-chars

# Salt used when hashing IP and user-agent strings for abuse mitigation.
# Rotated quarterly; hashes are retained for 30 days (doc 23 §23.9).
ABUSE_HASH_SALT=replace-me-with-another-random-value-at-least-32-chars

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Structured log level: debug | info | warn | error
LOG_LEVEL=info

# How many reverse proxies sit in front of the app.
#
# The client address is read from X-Forwarded-For at this many places from the right, because
# every hop appends and only the rightmost entries were written by infrastructure you control.
# Reading the leftmost entry would read a value the client chose, and that value keys the per-IP
# rate limits on registration, sign-in and password reset.
#
# 1 suits a single reverse proxy or load balancer. Raise it for more hops you control. Set 0
# only when the app is exposed directly with nothing rewriting the header -- per-IP rate
# limiting then has no address to work with and falls back to one shared bucket.
TRUSTED_PROXY_HOPS=1

# Email transport for verification and password-reset messages.
#
# console  -- writes the message to stdout. The development default. In production it refuses to
#             pretend: it reports a failed delivery and logs an error on every send.
# resend   -- https://api.resend.com/emails
# postmark -- https://api.postmarkapp.com/email
#
# EMAIL_API_KEY and EMAIL_FROM are required whenever the transport is not "console", and the app
# refuses to start without them rather than failing on someone else s password reset. EMAIL_FROM
# must be on a domain the provider has verified, or every send is rejected.
EMAIL_TRANSPORT=console
# EMAIL_API_KEY=
# EMAIL_FROM=SensLab <no-reply@example.com>
